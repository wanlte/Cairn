# Cairn 生产环境配置模板
# 复制为 .env.production 后逐项填写；该文件含密钥，已被 .gitignore 排除，永远不要提交 Git

ENVIRONMENT=prod

# ---- 数据库与缓存（容器网络内部地址，不要改成 127.0.0.1）----
# POSTGRES_PASSWORD 与 DATABASE_URL 中的密码需保持一致
POSTGRES_PASSWORD=please-change-me-at-least-16-chars
DATABASE_URL=postgresql+asyncpg://cairn:please-change-me-at-least-16-chars@postgres:5432/cairn
REDIS_URL=redis://redis:6379/0

# ---- 密钥（在服务器上执行 openssl rand -hex 32 生成，两项不要相同）----
CAIRN_SECRET_KEY=
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=7

# ---- CORS：只放正式来源；同域反代部署下填自己的站点即可 ----
CORS_ORIGINS=["https://your-domain.com"]

# ---- 模型 Provider（至少配一个；也可上线后在「凭证」面板保存加密凭证）----
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=doubao-seed-2-1-lite
HUNYUAN_BASE_URL=https://tokenhub.tencentcloudapi.com/v1
HUNYUAN_MODEL=hunyuan-hy4
# 单实例部署可选：直接读取环境变量，凭证不落库；不要提交真实密钥
# DEEPSEEK_API_KEY=
# VOLCENGINE_API_KEY=
# HUNYUAN_API_KEY=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_MODEL=
DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding
VOLCENGINE_EMBEDDING_MODEL=doubao-embedding-text-240715
HUNYUAN_EMBEDDING_MODEL=hunyuan-embedding
OPENAI_COMPAT_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- 模型网关限流与熔断（个人部署默认值即可）----
GATEWAY_QPS=5
GATEWAY_CONCURRENCY=20
GATEWAY_RETRY_MAX=3
GATEWAY_CIRCUIT_FAIL_MAX=10
GATEWAY_CIRCUIT_RESET_SECONDS=30
GATEWAY_PROBE_CACHE_HOURS=24

# ---- 评测阈值 ----
EVAL_EXTRACTION_ACCURACY_THRESHOLD=0.8
EVAL_REVIEW_CONSISTENCY_THRESHOLD=0.7
EVAL_RETRIEVAL_RECALL_THRESHOLD=0.75
